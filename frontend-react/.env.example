# Frontend build variables (Vite). Set these in Vercel → Project → Environment Variables.

# Backend URL. Defaults to http://localhost:5001 in development and the Render
# service in production builds.
VITE_API_URL=https://milquu-backend.onrender.com

# Google OAuth client id for "Sign in with Google" (same value as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 measurement id
VITE_GA_MEASUREMENT_ID=
