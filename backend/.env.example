# Database
MONGO_URI=mongodb://localhost:27017/milquu          # dev: local Mongo
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/milquu   # production: Atlas

# Auth — sign the token, sign everyone out on rotation
JWT_SECRET=                                          # 64+ random chars; generate with:
                                                      # node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Server
NODE_ENV=development                                 # development | production
PORT=5001

# CORS — comma-separated, no spaces, no trailing slashes.
# Every browser origin the API must accept a request from. localhost is added
# automatically in development, so it doesn't need to be listed here.
CORS_ORIGIN=https://milquufresh.vercel.app,https://milquufresh.in,https://www.milquufresh.in

# Cloudinary — image uploads (backend/utils/uploadConfig.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — wallet top-ups and checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini — chatbot
GEMINI_API_KEY=

# Sentry — error monitoring (optional; errors are only reported when set)
SENTRY_DSN=

# Nightly subscription engine: set true only if the Render cron job
# (milquu-subscription-engine) is the sole runner and the in-process safety
# net in server.js should be skipped.
DISABLE_IN_PROCESS_CRON=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
