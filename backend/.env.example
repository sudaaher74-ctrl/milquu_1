# Backend environment. The server reads this file from the REPOSITORY ROOT
# (backend/server.js loads ../.env). Copy it to .env and fill it in.
# On Render, set the same keys in the service's Environment tab.

# Database
MONGO_URI=mongodb://localhost:27017/milquu          # production: your Atlas URI (never commit it)

# Auth — 64+ random chars. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Server
NODE_ENV=development                                 # development | production
PORT=5001

# CORS — comma-separated, no spaces, no trailing slashes. localhost is added
# automatically in development.
CORS_ORIGIN=https://milquufresh.vercel.app,https://milquufresh.in,https://www.milquufresh.in

# Google sign-in — the OAuth client id (same value as the frontend's
# VITE_GOOGLE_CLIENT_ID). Defaults to the client id the frontend ships with.
GOOGLE_CLIENT_ID=

# Razorpay — checkout and wallet top-ups
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary — image uploads (proof of delivery, product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — low-balance and plan-paused notices from the nightly engine
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MilQuu Fresh <noreply@milquufresh.in>"

# Sarvam AI — India's Sovereign 105B LLM for MilQuu AI Chatbot (primary)
# Get key from https://sarvam.ai dashboard
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations

# Gemini — secondary admin AI assistant (fallback)
GEMINI_API_KEY=

# Sentry — error monitoring (optional)
SENTRY_DSN=

# Set true only if the Render cron job is the sole runner of the nightly
# subscription engine and the in-process safety net should be skipped.
DISABLE_IN_PROCESS_CRON=

# Admin seeder only (npm run seed:admin) — not needed by the running server.
ADMIN_EMAIL=
ADMIN_PASSWORD=
